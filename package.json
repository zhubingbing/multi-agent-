{
  "name": "multi-agent",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm --filter @multi-agent/pi-host build && pnpm --filter @multi-agent/web build",
    "dev:host": "pnpm --filter @multi-agent/pi-host dev",
    "dev:web": "pnpm --filter @multi-agent/web dev",
    "typecheck": "pnpm -r typecheck"
  }
}
