[Unit]
Description=Multi Agent Web Workbench (React + Vite)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/code/code.bing.com/btc/multi-agent/apps/workbench-web
Environment=NODE_ENV=development
ExecStart=/usr/bin/env corepack pnpm dev
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
